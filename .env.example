# Copy this file to .env and fill in your values.
#
# Any value may instead be the *name* of an environment variable already set in
# your shell/host. If a variable with that name exists its value is used;
# otherwise the literal value written here is used as-is.
# Example: IRIS_API_KEY=MY_SECRET_VAR -> uses $MY_SECRET_VAR if set, else "MY_SECRET_VAR".

# ---- Redis Agent Memory service (Data Plane) ----
# Base URL of the data plane, must include https:// (no trailing path)
IRIS_SERVICE_URL=https://your-agent-memory-endpoint
IRIS_API_KEY=your-agent-key
# Store the documents are ingested into (e.g. st_xxxxxxxxxxxxxxxx)
IRIS_STORE_ID=your-store-id

# ---- Extractors: name -> ID mapping ----
# Comma delimited, same order and same number of values in both lists.
# The user is prompted with the names; the matching ID is sent as extractorId.
EXTRACTOR_NAMES=extractor-one,extractor-two
EXTRACTOR_IDS=ex_idforextractorone,ex_idforextractortwo

# ---- Redis database (where memories are stored; used for the meta-data step) ----
REDIS_DB_HOST=your-db-host.redis.io
REDIS_DB_PORT=6379
REDIS_DB_USER=default
REDIS_DB_PASSWORD=your-db-password
# Set to true if the database requires TLS
REDIS_DB_SSL=false
